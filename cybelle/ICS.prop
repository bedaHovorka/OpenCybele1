# Cybele ICS (Inter-Cybele Communication) browser list.
#
# Read by com.iai.cybele.comm.ics.daemon.IAIDaemon ONLY -- it is the sole class in
# either vendor jar that mentions "ICS.prop" or "ICSBrowser". IAIDaemon loads it with
# java.util.Properties.load (so a repeated key is LAST-ONE-WINS), merges it into the
# system properties, and splits ICSBrowser on ';' to get the hosts to contact.
#
# This application never starts an IAIDaemon: cybele.prop sets
#   cybele.srv.comm.app.param.iai = Local;NoSerialization
# so the comm service stays in-process. The file is therefore inert for the simulation
# as configured -- but not on the failure path: remove that setting and IAICommService
# builds an IAINetClient, which SPAWNS an IAIDaemon (its bytecode assembles a
# `java -classpath "..."` command line), and that daemon reads this file. The entry
# goes live exactly where startup is already broken, so it must not name a host we do
# not control.
#
# It used to declare TWO live ICSBrowser keys: the IAI host 63.122.105.110 and then
# 127.0.0.1. Last-one-wins meant 127.0.0.1 was already the effective value, so removing
# the external one changes nothing today -- it removes a latent startup hang that a
# reordering of the file, or a parser that took the FIRST key, would have activated.
# See issue #16.
#
# Historical vendored value, kept for the record:
#   ICSBrowser = 207.196.79.53;207.196.79.66;207.196.79.106;207.196.79.103
#   ICSBrowser = 63.122.105.110

ICSBrowser = 127.0.0.1
